<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

<IfModule mod_headers.c>
  # Razorpay checkout needs iframes, CDN scripts, QR images, and API calls.
  # Local dev has no CSP; production servers often block these and hide the UPI QR.
  Header always unset Content-Security-Policy
  Header always set Content-Security-Policy "\
    default-src 'self'; \
    script-src 'self' 'unsafe-inline' 'unsafe-eval' \
      https://checkout.razorpay.com https://api.razorpay.com https://cdn.razorpay.com https://*.razorpay.com \
      https://challenges.cloudflare.com \
      https://maps.googleapis.com \
      https://sandbox-payments.open.money https://payments.open.money; \
    style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; \
    img-src 'self' data: blob: https: https://*.razorpay.com https://cdn.razorpay.com; \
    font-src 'self' data: https://fonts.gstatic.com; \
    connect-src 'self' https: wss: \
      https://api.w1chat.com https://*.w1chat.com \
      https://checkout.razorpay.com https://api.razorpay.com https://cdn.razorpay.com https://*.razorpay.com \
      https://challenges.cloudflare.com; \
    frame-src 'self' \
      https://checkout.razorpay.com https://api.razorpay.com https://cdn.razorpay.com https://*.razorpay.com \
      https://challenges.cloudflare.com \
      https://sandbox-payments.open.money https://payments.open.money; \
    child-src 'self' blob: \
      https://checkout.razorpay.com https://api.razorpay.com https://cdn.razorpay.com https://*.razorpay.com; \
    worker-src 'self' blob:; \
    object-src 'none'; \
    base-uri 'self'; \
    form-action 'self' https://api.razorpay.com"

  # Allows Razorpay netbanking/card popups and nested checkout frames
  Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"
</IfModule>
